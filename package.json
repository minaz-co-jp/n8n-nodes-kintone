{
  "name": "n8n-nodes-kintone",
  "version": "0.1.0",
  "description": "Unofficial n8n community node for the kintone REST API",
  "license": "MIT",
  "homepage": "https://github.com/minaz-co-jp/n8n-nodes-kintone",
  "keywords": ["n8n-community-node-package", "n8n", "kintone", "cybozu"],
  "author": { "name": "MINAZ" },
  "repository": {
    "type": "git",
    "url": "https://github.com/minaz-co-jp/n8n-nodes-kintone.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": ["dist/credentials/KintoneApi.credentials.js"],
    "nodes": ["dist/nodes/Kintone/Kintone.node.js"]
  },
  "dependencies": {
    "@kintone/rest-api-client": "^6.2.1"
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
